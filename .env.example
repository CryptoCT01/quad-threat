# Copy to .env and fill in. Never commit real values.

# OpenRouter (Engine 2 Condor LLM)
OPENROUTER_API_KEY=CHANGE_ME

# Hummingbot password for decrypting local connector keystore (set by you)
HBOT_PASSWORD=CHANGE_ME

# Condor Telegram notifications — use 0 / CHANGE_ME until you set a real chat
CONDOR_CHAT_ID=0

# Hummingbot API (read by the E1 controller; no defaults for credentials)
HBOT_API_URL=http://hummingbot-api:8000
HBOT_API_USERNAME=CHANGE_ME
HBOT_API_PASSWORD=CHANGE_ME

# Pack is sized for ~$800 equity. Do not use these YAML sizes on a tiny live book.

